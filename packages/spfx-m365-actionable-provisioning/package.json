{
  "name": "@apvee/spfx-m365-actionable-provisioning",
  "version": "2.0.0",
  "description": "Reusable SPFx UI, hooks, and property pane controls for M365 actionable provisioning.",
  "keywords": [
    "spfx",
    "m365",
    "sharepoint",
    "provisioning",
    "fluentui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types && node scripts/copy-loc.cjs && node scripts/write-package-boundaries.cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "postinstall": "node scripts/post-install.cjs",
    "prepack": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/artifact test/webpack",
    "test:artifact": "vitest run test/artifact/package-artifact.test.ts",
    "test:webpack": "vitest run test/webpack/consumer-bundle.test.ts",
    "test:browser": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:browser"
  },
  "dependencies": {
    "tslib": "2.3.1"
  },
  "peerDependencies": {
    "@apvee/m365-actionable-provisioning": "1.0.0",
    "@apvee/react-layout-kit": "^1.2.0",
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "@fluentui/react-migration-v8-v9": "^9.9.18",
    "@fluentui/react-motion-components-preview": "^0.14.2",
    "@fluentui/theme": "^2.7.2",
    "@microsoft/sp-component-base": ">=1.21.1 <2.0.0",
    "@microsoft/sp-core-library": ">=1.21.1 <2.0.0",
    "@microsoft/sp-property-pane": ">=1.21.1 <2.0.0",
    "@microsoft/sp-webpart-base": ">=1.21.1 <2.0.0",
    "@pnp/graph": "^4.17.0",
    "@pnp/sp": "^4.17.0",
    "react": "17.0.1",
    "react-dom": "17.0.1"
  },
  "devDependencies": {
    "@apvee/m365-actionable-provisioning": "1.0.0",
    "@apvee/react-layout-kit": "^1.2.0",
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "@fluentui/react-migration-v8-v9": "^9.9.18",
    "@fluentui/react-motion-components-preview": "^0.14.2",
    "@fluentui/theme": "^2.7.2",
    "@microsoft/sp-component-base": "1.21.1",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-property-pane": "1.21.1",
    "@microsoft/sp-webpart-base": "1.21.1",
    "@playwright/test": "^1.62.1",
    "@pnp/graph": "^4.17.0",
    "@pnp/sp": "^4.17.0",
    "jsdom": "^30.0.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "ts-loader": "^9.6.2",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
